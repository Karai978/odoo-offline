diff --git a/controllers/translation_controller.py b/controllers/translation_controller.py
new file mode 100644
index 0000000..8b81e76
--- /dev/null
+++ b/controllers/translation_controller.py
@@ -0,0 +1,95 @@
+"""Authenticated helpers for Odoo's native translated-field API."""
+
+import json
+import logging
+
+from odoo import http  # type: ignore
+from odoo.exceptions import AccessError  # type: ignore
+from odoo.http import request  # type: ignore
+
+from .common import OfflineSyncMixin
+
+_logger = logging.getLogger(__name__)
+
+
+class TranslationController(http.Controller, OfflineSyncMixin):
+    @http.route(
+        "/offline_sync/field_translations",
+        type="http",
+        auth="none",
+        methods=["GET", "POST", "OPTIONS"],
+        csrf=False,
+    )
+    def field_translations(self, model=None, record_id=None, field_name=None, **kwargs):
+        if request.httprequest.method == "OPTIONS":
+            return self._cors_response()
+
+        user = self._authenticate_api_key()
+        if not user:
+            return self._cors_response(json.dumps({"error": "Clé API invalide"}), status=401)
+
+        method = request.httprequest.method
+        if method == "POST":
+            try:
+                body = json.loads(request.httprequest.data or b"{}")
+            except (TypeError, ValueError):
+                return self._cors_response(json.dumps({"error": "Corps JSON invalide"}), status=400)
+            model = body.get("model", model)
+            record_id = body.get("record_id", record_id)
+            field_name = body.get("field_name", field_name)
+            translations = body.get("translations")
+        else:
+            translations = None
+
+        env = request.env(user=user.id)
+        if not model or model not in env:
+            return self._cors_response(json.dumps({"error": "Modèle invalide"}), status=400)
+        try:
+            record_id = int(record_id)
+        except (TypeError, ValueError):
+            return self._cors_response(json.dumps({"error": "Identifiant invalide"}), status=400)
+
+        Model = env[model]
+        field = Model._fields.get(field_name)
+        # _fields contains private fields too; fields_get applies group-based
+        # field visibility for the authenticated user.
+        if (
+            not field
+            or field_name not in Model.fields_get([field_name])
+            or field.type != "char"
+            or not bool(getattr(field, "translate", False))
+        ):
+            return self._cors_response(json.dumps({"error": "Champ Char traduisible introuvable"}), status=404)
+
+        record = Model.browse(record_id).exists()
+        if not record:
+            return self._cors_response(json.dumps({"error": "Enregistrement introuvable"}), status=404)
+
+        access_mode = "read" if method == "GET" else "write"
+        try:
+            Model.check_access_rights(access_mode)
+            record.check_access_rule(access_mode)
+        except AccessError:
+            return self._cors_response(json.dumps({"error": "Accès refusé"}), status=403)
+
+        try:
+            if method == "GET":
+                # Keep the same argument convention as Odoo's web ORM call.
+                terms, context = Model.get_field_translations([record_id], field_name)
+                result = {
+                    "translations": terms,
+                    "context": context,
+                    "languages": env["res.lang"].get_installed(),
+                    "user_lang": env.user.lang,
+                }
+                return self._cors_response(json.dumps(self._json_safe(result)))
+
+            if not isinstance(translations, dict):
+                return self._cors_response(json.dumps({"error": "Translations doit être un objet"}), status=400)
+            Model.update_field_translations([record_id], field_name, translations)
+            return self._cors_response(json.dumps({"ok": True}))
+        except AccessError:
+            return self._cors_response(json.dumps({"error": "Accès refusé"}), status=403)
+        except Exception as error:
+            _logger.exception("Erreur API de traduction %s.%s#%s", model, field_name, record_id)
+            return self._cors_response(json.dumps({"error": str(error)}), status=400)
